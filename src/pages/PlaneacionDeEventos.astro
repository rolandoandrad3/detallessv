---
// pages/PlaneacionDeEventos.astro
import Layout from "../layouts/Layout.astro";
import Welcome from "../components/Welcome.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <section><Welcome /></section>

  <!-- HERO SECTION -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-detalles-pink via-white to-detalles-pink/30 py-16 sm:py-20 lg:py-28"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Text Content -->
        <div class="space-y-6 animate-slide-up">
          <span
            class="text-xs sm:text-sm font-semibold tracking-widest uppercase text-detalles-teal"
            >Planeación de Eventos</span
          >

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-gray-900 leading-tight"
          >
            Tu Evento Soñado, Hecho Realidad
          </h1>

          <p class="text-lg sm:text-xl text-gray-600 leading-relaxed">
            Desde la primera idea hasta el último detalle, nos encargamos de
            todo para que tú solo disfrutes de tu celebración perfecta.
          </p>

          <div class="flex flex-wrap gap-4 pt-4">
            <div class="flex items-center gap-2 text-gray-700">
              <svg
                class="w-6 h-6 text-detalles-teal"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="font-semibold">Planificación integral</span>
            </div>
            <div class="flex items-center gap-2 text-gray-700">
              <svg
                class="w-6 h-6 text-detalles-teal"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="font-semibold">Sin estrés, sin preocupaciones</span>
            </div>
          </div>
        </div>

        <!-- Image -->
        <div class="relative animate-scale-in">
          <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl">
            <img
              src="https://res.cloudinary.com/dtvin1hes/image/upload/v1770525205/photo_4965607765208837783_y_tmd24p.jpg"
              alt="Planeación de Eventos"
              class="w-full h-full object-cover aspect-square hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
          </div>
          <div
            class="absolute -bottom-6 -right-6 w-full h-full rounded-2xl -z-10 bg-gradient-to-br from-detalles-teal/20 to-detalles-pink opacity-60"
          >
          </div>
          <div
            class="absolute -top-6 -left-6 w-32 h-32 bg-detalles-teal/10 rounded-full blur-2xl -z-10"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUÉ INCLUYE -->
  <section class="py-16 sm:py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="mx-auto max-w-7xl">
      <div class="text-center mb-12 sm:mb-16">
        <span
          class="text-xs sm:text-sm font-semibold tracking-widest uppercase text-detalles-teal"
          >Nuestro Servicio</span
        >
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-gray-900 mt-4"
        >
          Todo lo que Incluye
        </h2>
        <p class="text-lg text-gray-600 mt-4 max-w-2xl mx-auto">
          Nos encargamos de cada aspecto de tu evento para que sea perfecto
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Servicio 1 -->
        <div
          class="bg-gradient-to-b from-detalles-pink/20 to-white rounded-2xl p-6 sm:p-8 shadow-lg hover:shadow-xl transition-shadow duration-300"
        >
          <div
            class="w-14 h-14 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center mb-6"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-gray-900 mb-3">
            Consultoría Inicial
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Reunión completa para conocer tu visión, presupuesto y
            expectativas. Creamos un plan personalizado.
          </p>
        </div>

        <!-- Servicio 2 -->
        <div
          class="bg-gradient-to-b from-detalles-pink/20 to-white rounded-2xl p-6 sm:p-8 shadow-lg hover:shadow-xl transition-shadow duration-300"
        >
          <div
            class="w-14 h-14 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center mb-6"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-gray-900 mb-3">
            Selección de Lugar
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Te ayudamos a encontrar y reservar el lugar perfecto según tu tipo
            de evento y número de invitados.
          </p>
        </div>

        <!-- Servicio 3 -->
        <div
          class="bg-gradient-to-b from-detalles-pink/20 to-white rounded-2xl p-6 sm:p-8 shadow-lg hover:shadow-xl transition-shadow duration-300"
        >
          <div
            class="w-14 h-14 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center mb-6"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-gray-900 mb-3">
            Diseño y Decoración
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Creamos el ambiente perfecto con decoración, mobiliario, mantelería
            y todos los detalles visuales.
          </p>
        </div>

        <!-- Servicio 4 -->
        <div
          class="bg-gradient-to-b from-detalles-pink/20 to-white rounded-2xl p-6 sm:p-8 shadow-lg hover:shadow-xl transition-shadow duration-300"
        >
          <div
            class="w-14 h-14 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center mb-6"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-gray-900 mb-3">
            Coordinación de Proveedores
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Gestionamos catering, fotografía, música, pastel y todo lo que
            necesites con nuestros aliados de confianza.
          </p>
        </div>

        <!-- Servicio 5 -->
        <div
          class="bg-gradient-to-b from-detalles-pink/20 to-white rounded-2xl p-6 sm:p-8 shadow-lg hover:shadow-xl transition-shadow duration-300"
        >
          <div
            class="w-14 h-14 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center mb-6"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-gray-900 mb-3">
            Cronograma Detallado
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Planificación minuto a minuto del evento para que todo fluya
            perfectamente sin contratiempos.
          </p>
        </div>

        <!-- Servicio 6 -->
        <div
          class="bg-gradient-to-b from-detalles-pink/20 to-white rounded-2xl p-6 sm:p-8 shadow-lg hover:shadow-xl transition-shadow duration-300"
        >
          <div
            class="w-14 h-14 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center mb-6"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-gray-900 mb-3">
            Coordinación el Día del Evento
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Nuestro equipo estará presente supervisando cada detalle. Tú solo
            disfruta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section
    class="py-16 sm:py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-detalles-pink/30 to-white"
  >
    <div class="mx-auto max-w-7xl">
      <div class="text-center mb-12 sm:mb-16">
        <span
          class="text-xs sm:text-sm font-semibold tracking-widest uppercase text-detalles-teal"
          >Nuestro Proceso</span
        >
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-gray-900 mt-4"
        >
          Así Trabajamos Contigo
        </h2>
      </div>

      <div class="space-y-8">
        <!-- Paso 1 -->
        <div
          class="flex flex-col md:flex-row items-start gap-6 bg-white rounded-2xl p-6 sm:p-8 shadow-lg"
        >
          <div
            class="w-16 h-16 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center flex-shrink-0"
          >
            <span class="text-2xl font-bold text-white">1</span>
          </div>
          <div class="flex-1">
            <h3
              class="text-xl sm:text-2xl font-display font-bold text-gray-900 mb-3"
            >
              Primera Reunión y Presupuesto
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Nos reunimos contigo para conocer tu visión del evento, tus ideas
              y expectativas. Definimos fecha, lugar, número de invitados y
              presupuesto. Te damos una cotización completa sin compromisos.
            </p>
          </div>
        </div>

        <!-- Paso 2 -->
        <div
          class="flex flex-col md:flex-row items-start gap-6 bg-white rounded-2xl p-6 sm:p-8 shadow-lg"
        >
          <div
            class="w-16 h-16 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center flex-shrink-0"
          >
            <span class="text-2xl font-bold text-white">2</span>
          </div>
          <div class="flex-1">
            <h3
              class="text-xl sm:text-2xl font-display font-bold text-gray-900 mb-3"
            >
              Diseño y Propuesta Detallada
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Creamos una propuesta visual con esquemas de distribución,
              paletas de colores, ejemplos de decoración y un cronograma
              preliminar. Todo se ajusta hasta que estés 100% feliz.
            </p>
          </div>
        </div>

        <!-- Paso 3 -->
        <div
          class="flex flex-col md:flex-row items-start gap-6 bg-white rounded-2xl p-6 sm:p-8 shadow-lg"
        >
          <div
            class="w-16 h-16 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center flex-shrink-0"
          >
            <span class="text-2xl font-bold text-white">3</span>
          </div>
          <div class="flex-1">
            <h3
              class="text-xl sm:text-2xl font-display font-bold text-gray-900 mb-3"
            >
              Coordinación y Reservas
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Confirmamos el lugar, contratamos proveedores confiables, hacemos
              todas las reservas necesarias y te mantenemos informado de cada
              paso. Tú solo apruebas, nosotros ejecutamos.
            </p>
          </div>
        </div>

        <!-- Paso 4 -->
        <div
          class="flex flex-col md:flex-row items-start gap-6 bg-white rounded-2xl p-6 sm:p-8 shadow-lg"
        >
          <div
            class="w-16 h-16 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center flex-shrink-0"
          >
            <span class="text-2xl font-bold text-white">4</span>
          </div>
          <div class="flex-1">
            <h3
              class="text-xl sm:text-2xl font-display font-bold text-gray-900 mb-3"
            >
              Montaje y Ejecución
            </h3>
            <p class="text-gray-600 leading-relaxed">
              El día del evento, llegamos temprano para montar todo. Nuestro
              equipo coordina a los proveedores, supervisa cada detalle y
              resuelve cualquier imprevisto. Tú solo disfrutas tu celebración
              perfecta.
            </p>
          </div>
        </div>

        <!-- Paso 5 -->
        <div
          class="flex flex-col md:flex-row items-start gap-6 bg-white rounded-2xl p-6 sm:p-8 shadow-lg"
        >
          <div
            class="w-16 h-16 rounded-full bg-gradient-to-br from-detalles-teal to-detalles-teal-dark flex items-center justify-center flex-shrink-0"
          >
            <span class="text-2xl font-bold text-white">5</span>
          </div>
          <div class="flex-1">
            <h3
              class="text-xl sm:text-2xl font-display font-bold text-gray-900 mb-3"
            >
              Desmontaje y Seguimiento
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Al finalizar, nos encargamos del desmontaje y limpieza. Después
              nos comunicamos contigo para asegurarnos de que todo haya sido
              perfecto y recibir tu retroalimentación.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIPOS DE EVENTOS -->
  <section class="py-16 sm:py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="mx-auto max-w-7xl">
      <div class="text-center mb-12 sm:mb-16">
        <span
          class="text-xs sm:text-sm font-semibold tracking-widest uppercase text-detalles-teal"
          >Tipos de Eventos</span
        >
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-gray-900 mt-4"
        >
          Eventos que Planificamos
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Tipo 1 -->
        <div
          class="relative overflow-hidden rounded-2xl shadow-lg group hover:shadow-2xl transition-shadow duration-300"
        >
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src="https://res.cloudinary.com/dtvin1hes/image/upload/v1770525205/photo_4965234828903559463_y_qjzn3v.jpg"
              alt="Bodas"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
          </div>
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <h3 class="text-2xl font-display font-bold text-white">Bodas</h3>
          </div>
        </div>

        <!-- Tipo 2 -->
        <div
          class="relative overflow-hidden rounded-2xl shadow-lg group hover:shadow-2xl transition-shadow duration-300"
        >
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src="https://res.cloudinary.com/dtvin1hes/image/upload/v1770525204/photo_4965234828903559493_y_1_jb2iii.jpg"
              alt="XV Años"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
          </div>
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <h3 class="text-2xl font-display font-bold text-white">XV Años</h3>
          </div>
        </div>

        <!-- Tipo 3 -->
        <div
          class="relative overflow-hidden rounded-2xl shadow-lg group hover:shadow-2xl transition-shadow duration-300"
        >
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src="https://res.cloudinary.com/dtvin1hes/image/upload/v1770525205/photo_4965234828903559490_y_vedych.jpg"
              alt="Cumpleaños"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
          </div>
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <h3 class="text-2xl font-display font-bold text-white">
              Cumpleaños
            </h3>
          </div>
        </div>

        <!-- Tipo 4 -->
        <div
          class="relative overflow-hidden rounded-2xl shadow-lg group hover:shadow-2xl transition-shadow duration-300"
        >
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src="https://res.cloudinary.com/dtvin1hes/image/upload/v1770596411/photo_4965234828903559489_y_qmnkay.jpg"
              alt="Eventos Corporativos"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
          </div>
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <h3 class="text-2xl font-display font-bold text-white">
              Eventos Corporativos
            </h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section
    class="py-16 sm:py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-detalles-pink/30 to-white"
  >
    <div class="mx-auto max-w-4xl text-center">
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-gray-900 mb-6"
      >
        ¿Listo para Empezar a Planificar?
      </h2>
      <p class="text-lg sm:text-xl text-gray-600 mb-8 leading-relaxed">
        Agenda una consulta gratuita y descubre cómo podemos hacer realidad el
        evento de tus sueños sin estrés y con resultados increíbles.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a  href="/cotizacion"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full text-white font-bold text-lg transition-all duration-300 hover:shadow-2xl hover:scale-105 bg-gradient-to-r from-detalles-teal to-detalles-teal-dark focus:outline-none focus:ring-2 focus:ring-detalles-teal focus:ring-offset-2"
        >
          Consulta Gratuita
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>

        
        <a  href="tel:+50377777777"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full text-detalles-teal font-bold text-lg transition-all duration-300 hover:shadow-xl bg-white border-2 border-detalles-teal hover:bg-detalles-teal hover:text-white focus:outline-none focus:ring-2 focus:ring-detalles-teal focus:ring-offset-2"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          Llámanos Ahora
        </a>
      </div>
    </div>
  </section>

  <section><Footer /></section>
</Layout>