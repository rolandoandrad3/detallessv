---
interface Props {
  title: string;
  description: string;
  buttonText: string;
  image: string;
}

const { title, description, buttonText, image } = Astro.props
---

<div class="w-60 bg-white rounded-xl shadow-lg p-2 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
  <img
    class="h-40 w-full object-cover rounded-xl"
    src={image}
    alt={title}
  />

  <div class="p-2">
    <h2 class="font-bold text-lg mb-2">{title}</h2>

    <p class="text-sm text-gray-600">
      {description}
    </p>
  </div>

  <div class="m-2">
    
    <a  href="#"
      class="inline-block text-white bg-purple-600 px-3 py-1 rounded-md hover:bg-purple-700 transition-colors duration-300"
    >
      {buttonText}
    </>
  </div>
</div>